# Copy this file to .env and fill it in. Never commit .env.
NODE_ENV=production
PORT=1000

# ---- database (use an account that only has rights on this database, not root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=eps_app
DB_PASS=
DB_NAME=db_eps
DB_DIALECT=mysql
# DB_POOL_MAX=20
# DB_LOGGING=true        # prints every SQL statement: only to debug

# ---- security (the server refuses to start in production if these are weak)
# JWT_SECRET: at least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# API_KEY: at least 16 characters; the same value is VUE_APP_API_KEY in the two web apps' quasar.config.js
API_KEY=
# the exact addresses of the apps, comma separated, no "*"
CORS_ORIGINS=https://feedback.example.gov.ph,https://portal.example.gov.ph
# how many reverse proxies (nginx, IIS...) sit in front of this server; needed for the rate limits to see real visitors
TRUST_PROXY=1

# ---- the citizen portal's public address (put in the emails sent to clients)
PORTAL_URL=https://portal.example.gov.ph

# ---- email (Gmail app password)
MAIL_USER=
MAIL_PASS=
# CLIENT_INVITE_DAILY_CAP=450
# CLIENT_INVITE_PAUSE_MS=1200

# ---- AI providers, tried in this order; set at least one (see utils/llm.js)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
